PORT=3001
APP_ORIGIN=http://localhost:5173
# Only needed when the API uses a different public origin than the frontend.
SERVER_ORIGIN=
NODE_ENV=development
# Leave these blank for local development. Production requires all three.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated profile UUIDs allowed to access the platform admin dashboard.
ADMIN_USER_IDS=
# Optional TURN server for calls through restrictive networks. Server-only secret.
TURN_URL=
TURN_SECRET=
# Set only behind a known reverse proxy (Render: 1).
TRUST_PROXY=0
# Optional remote API origin when hosting the frontend separately (not a secret).
VITE_API_URL=
